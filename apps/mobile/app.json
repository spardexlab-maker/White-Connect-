{
  "expo": {
    "name": "أبيض",
    "slug": "white-connect",
    "scheme": "whiteconnect",
    "version": "1.0.0",
    "runtimeVersion": "3",
    "updates": {
      "url": "https://utuwjykgubsqqescpiwz.supabase.co/functions/v1/app-update",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "bundleIdentifier": "com.spardexlab.abyad",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "يُستخدم موقعك اختيارياً لترتيب الأطباء والمختبرات حسب القرب منك، ولإرساله للمختبر عندما تطلب سحب عينة من البيت. الحجز لا يحتاج الموقع.",
        "NSMicrophoneUsageDescription": "يُستخدم المايكروفون فقط عندما تضغط زر المايك للتحدث مع المساعد الذكي، ولا يُحفظ التسجيل.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "ar"
      },
      "buildNumber": "1",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.spardexlab.abyad",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "REQUEST_INSTALL_PACKAGES",
        "RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "READ_CONTACTS"
      ],
      "versionCode": 13,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 220
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F766E"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يُستخدم الموقع اختيارياً لترتيب الأطباء والمختبرات حسب القرب. الحجز لا يحتاج الموقع."
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "يُستخدم المايكروفون فقط عندما تضغط زر المايك للتحدث مع المساعد الذكي، ولا يُحفظ التسجيل."
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
