{
  "name": "medical-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @app/web dev",
    "build": "pnpm --filter @app/shared build && pnpm --filter @app/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "test:integration": "vitest run --root tests/integration",
    "screenshots": "node scripts/screenshots.mjs",
    "e2e": "node scripts/e2e-booking-journey.mjs",
    "e2e:clinical": "node scripts/e2e-clinical-journey.mjs",
    "screenshots:clinical": "node scripts/e2e-clinical-journey.mjs && node scripts/screenshots-phase3.mjs",
    "e2e:operations": "node scripts/e2e-operations.mjs",
    "e2e:mfa": "node scripts/e2e-admin-mfa.mjs",
    "mobile": "pnpm --filter @app/mobile start",
    "mobile:export:web": "pnpm --filter @app/mobile export:web",
    "e2e:mobile": "node scripts/e2e-mobile.mjs apps/mobile/dist",
    "mobile:assets": "node scripts/mobile-assets.mjs",
    "e2e:admin-roles": "node scripts/e2e-admin-roles.mjs",
    "e2e:homelab": "node scripts/e2e-home-lab.mjs",
    "e2e:join": "node scripts/e2e-join.mjs",
    "e2e:openlab": "node scripts/e2e-open-lab.mjs",
    "film": "bash docs/film/build.sh"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "playwright": "1.56.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
