{
  "name": "medical-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @app/web dev",
    "build": "pnpm --filter @app/shared build && pnpm --filter @app/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "test:integration": "vitest run --root tests/integration",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
