# ---------------------------------------------------------------
# Client (browser) variables — PUBLIC values only. Never put a secret
# behind a VITE_ / NEXT_PUBLIC_ / EXPO_PUBLIC_ prefix.
# Copy to apps/web/.env.local and adjust.
# ---------------------------------------------------------------

# Cloud project (publishable key is safe in the client; access is enforced by Auth + RLS)
VITE_SUPABASE_URL=https://utuwjykgubsqqescpiwz.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_8EOYs1nveiegSBChdGb8jw_L65_dJ01

# Local development (values printed by `supabase status`):
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=<local publishable/anon key from `supabase status`>

# Central product name placeholder (owner has not chosen a brand yet)
VITE_PRODUCT_NAME=منصة الرعاية

# ---------------------------------------------------------------
# Server-only secrets — set in the Supabase dashboard secret store
# (Edge Functions → Secrets), NEVER in this file, the web app or the mobile app.
# ---------------------------------------------------------------
# APP_SUPABASE_SECRET_KEY=<SERVER_SECRET_STORE_VALUE>
# PUSH_PROVIDER=mock            # mock | fcm | expo   (mock = development only)
# SMS_PROVIDER=mock             # mock | <provider>    (requires a paid account)
# WORKER_SHARED_SECRET=<random> # used by pg_cron → notifications-worker
